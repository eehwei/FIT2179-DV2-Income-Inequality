{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 500,
  "title": {"text": "Poverty Rate by Malaysian State (2022)", "fontSize": 18},
  "data": {"url": "data/poverty_by_state.csv"},
  "transform": [{"filter": "year(toDate(datum.date)) == 2022"}],
  "layer": [
    {
      "mark": "bar",
      "encoding": {
        "y": {
          "field": "state",
          "type": "nominal",
          "sort": "-x",
          "axis": {"title": null, "labelFontSize": 12}
        },
        "x": {
          "field": "poverty",
          "type": "quantitative",
          "axis": {"title": "Poverty Rate (%)", "format": ".1f", "titleFontSize": 13, "labelFontSize": 11}
        },
        "color": {
          "condition": [
            {"test": "datum.poverty > 10", "value": "#d62728"},
            {"test": "datum.poverty < 3", "value": "#1f77b4"}
          ],
          "value": "#ff7f0e"
        },
        "tooltip": [
          {"field": "state", "type": "nominal", "title": "State"},
          {"field": "poverty", "type": "quantitative", "title": "Poverty Rate (%)", "format": ".2f"},
          {"field": "income_median", "type": "quantitative", "title": "Median Income (RM)", "format": ",.0f"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 8, "fontSize": 10, "fontWeight": "bold", "color": "#d62728"},
      "encoding": {
        "y": {"field": "state", "type": "nominal", "sort": "-x"},
        "x": {"field": "poverty", "type": "quantitative"},
        "text": {"condition": {"test": "datum.poverty > 10", "value": "⚠️ Poorest"}, "value": ""}
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 8, "fontSize": 10, "fontWeight": "bold", "color": "#1f77b4"},
      "encoding": {
        "y": {"field": "state", "type": "nominal", "sort": "-x"},
        "x": {"field": "poverty", "type": "quantitative"},
        "text": {"condition": {"test": "datum.poverty < 3", "value": "✓ Richest"}, "value": ""}
      }
    }
  ]
}